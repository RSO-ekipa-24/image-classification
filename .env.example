# Keycloak Configuration
KEYCLOAK_URL=https://keycloak.yourdomain.com
KEYCLOAK_REALM_NAME=your-realm
KEYCLOAK_CLIENT_ID=your-client-id
KEYCLOAK_CLIENT_SECRET=your-client-secret
KEYCLOAK_SERVICE_CLIENT_ID=service-client-id
KEYCLOAK_SERVICE_CLIENT_SECRET=service-client-secret

# External Service
FILE_SERVICE_TAGS_URL=http://file-service:8080/api/tags

# Google Cloud (set by container)
# GOOGLE_APPLICATION_CREDENTIALS=/root/.config/gcloud/application_default_credentials.json